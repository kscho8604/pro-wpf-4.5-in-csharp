<Window x:Class="Drawing.Shapes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shapes"
        Height="800"
        Width="366">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"></RowDefinition>
      <RowDefinition Height="*"></RowDefinition>
    </Grid.RowDefinitions>
    <StackPanel x:Name="MyStackPanel">
      <Ellipse Fill="Yellow"
               Stroke="Blue"
               Width="100"
               Height="50"
               Margin="5"
               HorizontalAlignment="Left"
               MouseDown="MouseDown"></Ellipse>
      <Rectangle Fill="Yellow"
                 Stroke="Blue"
                 Width="100"
                 Height="50"
                 Margin="5"
                 MouseDown="MouseDown"
                 HorizontalAlignment="Left"></Rectangle>
      <Line X1="10"
            Y1="-20"
            X2="110"
            Y2="100"
            Stroke="Red"
            StrokeThickness="2"/>
      <Polyline Points="10,50 50,10 90,50 130,10"
                Stroke="Blue"
                StrokeThickness="3"/>
      <Polygon Points="50,10 10,90 90,90"
               Fill="Orange"
               Stroke="Black"/>
      <Path Data="M 10,10 L 100,10 L 100,100 Z"
            Fill="Purple"
            Stroke="Black"/>
      <Path Data="M 10,10 L 100,10 L 100,100 Z"
            Stroke="Black"/>
    </StackPanel>

    <Canvas Grid.Row="1">
      <Ellipse Fill="Yellow"
               Stroke="Blue"
               Canvas.Left="100"
               Canvas.Top="50"
               Width="100"
               Height="50"
               MouseDown="MouseDown"></Ellipse>
      <Rectangle Fill="Yellow"
                 Stroke="Blue"
                 Canvas.Left="30"
                 Canvas.Top="40"
                 Width="100"
                 MouseDown="MouseDown"
                 Height="50"></Rectangle>

    </Canvas>
  </Grid>
</Window>
